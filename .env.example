# Select one: local (development only), d1, firebase, or supabase.
DATABASE_PROVIDER=local

# Protect /activity with a private password. Generate a random 32+ character session secret.
ADMIN_PASSWORD=change-this-before-deploying
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional submission email notifications. Verify the sender domain with Resend first.
NOTIFY_EMAIL=you@example.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Farewell Notebook <hello@your-domain.example>

# Optional privacy-preserving repeat-visitor matching. Leave blank to disable.
FAREWELL_FINGERPRINT_KEY=

# Cloudflare D1 (needed only when DATABASE_PROVIDER=d1).
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Firebase Firestore (needed only when DATABASE_PROVIDER=firebase).
# Paste the service-account JSON as one line. Keep it only in local/host secrets.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Supabase (needed only when DATABASE_PROVIDER=supabase).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
